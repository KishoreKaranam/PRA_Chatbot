pra:sup_FraudManagement a pra:BusinessFunction,
        pra:SupportingFunction ;
    rdfs:label "Fraud Management" ;
    dcterms:description "Fraud Management is a specialized domain that acts on both payment orders and transactions in process. It performs initial fraud screening when the payment order is captured and applies real-time monitoring during execution. Suspicious transactions can be flagged, held, or rejected, and anomalies detected during processing may lead to halting or escalation for investigation." ;
    prov:wasDerivedFrom pra:asset_SupportXlsx ;
    pra:dependsOn pra:func_OrderEnrichment,
        pra:func_OrderRegistration,
        pra:func_PaymentInstructionCapture,
        pra:func_PaymentInstructionSubmission,
