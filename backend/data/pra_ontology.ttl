@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pra: <https://example.org/pra#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/pra> a owl:Ontology ;
    rdfs:label "Payments Reference Architecture Ontology" ;
    dcterms:created "2026-03-19"^^xsd:date ;
    dcterms:description "Payments Reference Architecture ontology and instance graph regenerated from the PRA Scope and Overlay Model word document, the Payment Journey workbook, and the Supporting Domains workbook. This version keeps the corrected dependency/provider direction and also models supporting-workbook rows as supporting functions grouped under supporting domains, instead of promoting those functions to standalone domains." ;
    dcterms:modified "2026-04-28"^^xsd:date ;
    owl:versionInfo "0.3-corrected-support-function-split" .

pra:Applicable a pra:ApplicabilityStatus ;
    rdfs:label "Applicable" ;
    rdfs:comment "The assessed element applies to the scheme." .

pra:Critical a pra:ApplicabilityStatus ;
    rdfs:label "Critical" ;
    rdfs:comment "The assessed element applies to the scheme and is marked critical." .

pra:NotApplicable a pra:ApplicabilityStatus ;
    rdfs:label "Not applicable" ;
    rdfs:comment "The assessed element does not apply to the scheme." .

pra:TraceabilityNote_FunctionSupportDirection a pra:EditorialNote ;
    rdfs:label "Function support direction corrected" ;
    dcterms:description "Supporting domains that consume outputs from journey functions are modeled with pra:dependsOn. Only supporting domains that provide data, decisions, or capabilities to journey functions are modeled with pra:supportsFunction and roll up to pra:supportsDomain." ;
    prov:wasDerivedFrom pra:asset_JourneyXlsx,
        pra:asset_ScopeDoc,
        pra:asset_SupportXlsx ;
    pra:modellingStatus "editorial-note" ;
    pra:sourceAsset pra:asset_JourneyXlsx,
        pra:asset_ScopeDoc,
        pra:asset_SupportXlsx .

pra:TraceabilityNote_SupportingFunctionGrouping a pra:EditorialNote ;
    rdfs:label "Supporting workbook rows modelled as functions" ;
    dcterms:description "The Supporting Domains workbook uses a Layer column plus a Function column. In this version, workbook rows such as Customer Accounts Management and Customer Support & Investigations are modelled as SupportingFunction instances that belong to a supporting domain inferred from the Layer value, rather than as standalone domains." ;
    prov:wasDerivedFrom pra:asset_ProductPpt,
        pra:asset_ScopeDoc,
        pra:asset_SupportXlsx ;
    pra:modellingStatus "editorial-note" ;
    pra:sourceAsset pra:asset_ProductPpt,
        pra:asset_ScopeDoc,
        pra:asset_SupportXlsx .

pra:applicableToScheme a owl:ObjectProperty ;
    rdfs:label "applicable to scheme" ;
    rdfs:comment "Convenience relation stating that an element applies to a scheme." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:PaymentScheme .

pra:assesses a owl:ObjectProperty ;
    rdfs:label "assesses" ;
    rdfs:comment "Links an applicability assessment to the assessed element." ;
    rdfs:domain pra:ApplicabilityAssessment ;
    rdfs:range pra:PRAElement .

pra:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "A generic dependency relation between PRA elements." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:PRAElement .

pra:dependsOnDomain a owl:ObjectProperty ;
    rdfs:label "depends on domain" ;
    rdfs:comment "Convenience relation from a supporting domain to a main journey domain whose functions it depends on or consumes outputs from." ;
    rdfs:domain pra:SupportingDomain ;
    rdfs:range pra:MainJourneyDomain .

pra:forScheme a owl:ObjectProperty ;
    rdfs:label "for scheme" ;
    rdfs:comment "Links an applicability assessment to the relevant payment scheme." ;
    rdfs:domain pra:ApplicabilityAssessment ;
    rdfs:range pra:PaymentScheme .

pra:fromSupportingDomain a owl:ObjectProperty ;
    rdfs:label "from supporting domain" ;
    rdfs:comment "The supporting domain from which the support link originates." ;
    rdfs:domain pra:SupportLink ;
    rdfs:range pra:SupportingDomain .

pra:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Links an element to one or more governing business rules." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:BusinessRule .

pra:hasActivity a owl:ObjectProperty ;
    rdfs:label "has activity" ;
    rdfs:comment "Links an element to one or more activities." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:Activity .

pra:hasApplicabilityAssessment a owl:ObjectProperty ;
    rdfs:label "has applicability assessment" ;
    rdfs:comment "Links an element to a payment-scheme applicability assessment." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:ApplicabilityAssessment .

pra:hasApplicabilityNote a owl:DatatypeProperty ;
    rdfs:label "has applicability note" ;
    rdfs:comment "Raw applicability note from the source workbook." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:hasInputText a owl:DatatypeProperty ;
    rdfs:label "has input text" ;
    rdfs:comment "Raw input text captured from the source workbook." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:hasLayer a owl:ObjectProperty ;
    rdfs:label "has layer" ;
    rdfs:comment "Links a supporting domain to its business layer." ;
    rdfs:domain pra:SupportingDomain ;
    rdfs:range pra:BusinessLayer .

pra:hasOutputText a owl:DatatypeProperty ;
    rdfs:label "has output text" ;
    rdfs:comment "Raw output text captured from the source workbook." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:hasOverlay a owl:ObjectProperty ;
    rdfs:label "has overlay" ;
    rdfs:comment "Links an element to a client-specific overlay." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:ClientOverlay .

pra:hasPhase a owl:ObjectProperty ;
    rdfs:label "has phase" ;
    rdfs:comment "Links a business function to its process phase." ;
    rdfs:domain pra:BusinessFunction ;
    rdfs:range pra:ProcessPhase .

pra:hasPostcondition a owl:ObjectProperty ;
    rdfs:label "has postcondition" ;
    rdfs:comment "Links an element to one or more postconditions." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:Postcondition .

pra:hasPrecondition a owl:ObjectProperty ;
    rdfs:label "has precondition" ;
    rdfs:comment "Links an element to one or more preconditions." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:Precondition .

pra:hasPurposeStatement a owl:ObjectProperty ;
    rdfs:label "has purpose statement" ;
    rdfs:comment "Links an element to one or more purpose statements." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:PurposeStatement .

pra:hasStatus a owl:ObjectProperty ;
    rdfs:label "has status" ;
    rdfs:comment "Links an applicability assessment to its status." ;
    rdfs:domain pra:ApplicabilityAssessment ;
    rdfs:range pra:ApplicabilityStatus .

pra:hasSupportLink a owl:ObjectProperty ;
    rdfs:label "has support link" ;
    rdfs:comment "Links a supporting domain to a support link instance." ;
    rdfs:domain pra:SupportingDomain ;
    rdfs:range pra:SupportLink .

pra:inContext a owl:ObjectProperty ;
    rdfs:label "in context" ;
    rdfs:comment "Links an element to an operational context." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:OperationalContext .

pra:isFunctionOf a owl:ObjectProperty ;
    rdfs:label "is function of" ;
    rdfs:comment "Inverse of has function." ;
    rdfs:domain pra:BusinessFunction ;
    rdfs:range pra:Domain ;
    owl:inverseOf pra:hasFunction .

pra:modellingStatus a owl:DatatypeProperty ;
    rdfs:label "modelling status" ;
    rdfs:comment "Tag indicating whether an element is canonical, workbook-derived, or editorial-note." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:normalizedLabel a owl:DatatypeProperty ;
    rdfs:label "normalized label" ;
    rdfs:comment "Normalized label used during relation resolution." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:notes a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    rdfs:comment "Free-text modelling note." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:providesTo a owl:ObjectProperty ;
    rdfs:label "provides to" ;
    rdfs:comment "Links a PRA element to another element that receives data, state, decisions, or capability from it." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:PRAElement .

pra:rawFunctionText a owl:DatatypeProperty ;
    rdfs:label "raw function text" ;
    rdfs:comment "Raw function label extracted from the workbook support column." ;
    rdfs:domain pra:SupportLink ;
    rdfs:range xsd:string .

pra:rawHeaderText a owl:DatatypeProperty ;
    rdfs:label "raw header text" ;
    rdfs:comment "Raw support-domain header text extracted from the workbook." ;
    rdfs:domain pra:SupportLink ;
    rdfs:range xsd:string .

pra:rawRelationText a owl:DatatypeProperty ;
    rdfs:label "raw relation text" ;
    rdfs:comment "Raw relation text captured from a workbook cell." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:referencesStandard a owl:ObjectProperty ;
    rdfs:label "references standard" ;
    rdfs:comment "Links an element to an external standard or ontology." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:ExternalStandard .

pra:sourceAsset a owl:ObjectProperty ;
    rdfs:label "source asset" ;
    rdfs:comment "Links an element to a source knowledge asset from which it was derived." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range pra:KnowledgeAsset .

pra:sourceRow a owl:DatatypeProperty ;
    rdfs:label "source row" ;
    rdfs:comment "Worksheet row number from which the element was derived." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:integer .

pra:sourceSheet a owl:DatatypeProperty ;
    rdfs:label "source sheet" ;
    rdfs:comment "Worksheet name from which the element was derived." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:sourceWorkbook a owl:DatatypeProperty ;
    rdfs:label "source workbook" ;
    rdfs:comment "Workbook file name from which the element was derived." ;
    rdfs:domain pra:PRAElement ;
    rdfs:range xsd:string .

pra:supportsDomain a owl:ObjectProperty ;
    rdfs:label "supports domain" ;
    rdfs:comment "Convenience relation from a supporting domain to a main journey domain." ;
    rdfs:domain pra:SupportingDomain ;
    rdfs:range pra:MainJourneyDomain .

pra:supportsFunction a owl:ObjectProperty ;
    rdfs:label "supports function" ;
    rdfs:comment "Convenience relation from a supporting domain to a business function." ;
    rdfs:domain pra:SupportingDomain ;
    rdfs:range pra:BusinessFunction .

pra:toBusinessFunction a owl:ObjectProperty ;
    rdfs:label "to business function" ;
    rdfs:comment "The business function supported by the support link." ;
    rdfs:domain pra:SupportLink ;
    rdfs:range pra:BusinessFunction .

pra:toMainJourneyDomain a owl:ObjectProperty ;
    rdfs:label "to main journey domain" ;
    rdfs:comment "The main journey domain supported by the support link." ;
    rdfs:domain pra:SupportLink ;
    rdfs:range pra:MainJourneyDomain .

pra:ClientOverlay a owl:Class ;
    rdfs:label "Client overlay" ;
    rdfs:comment "A client-specific overlay that extends the PRA core without contaminating the shared core knowledge base." ;
    rdfs:subClassOf pra:KnowledgeAsset .

pra:ExternalStandard a owl:Class ;
    rdfs:label "External standard" ;
    rdfs:comment "An external standard or ontology referenced by the PRA, such as ISO 20022, SWIFT, PSD2, or scheme rulebooks." ;
    rdfs:subClassOf pra:KnowledgeAsset .

pra:activity_AccountReservation_1 a pra:Activity ;
    rdfs:label "Validate account existence and status." ;
    dcterms:description "Validate account existence and status." .

pra:activity_AccountReservation_2 a pra:Activity ;
    rdfs:label "Check balance and place hold." ;
    dcterms:description "Check balance and place hold." .

pra:activity_AccountReservation_3 a pra:Activity ;
    rdfs:label "Retry or move to exception queue if insufficient funds" ;
    dcterms:description "Retry or move to exception queue if insufficient funds" .

pra:activity_AccountSwitchingService_1 a pra:Activity ;
    rdfs:label "Redirect payments to new account." ;
    dcterms:description "Redirect payments to new account." .

pra:activity_AccountSwitchingService_2 a pra:Activity ;
    rdfs:label "Update routing and beneficiary details." ;
    dcterms:description "Update routing and beneficiary details." .

pra:activity_AccountSwitchingService_3 a pra:Activity ;
    rdfs:label "Maintain switch records (source account, destination account, effective dates, redirect duration)." ;
    dcterms:description "Maintain switch records (source account, destination account, effective dates, redirect duration)." .

pra:activity_AccountSwitchingService_4 a pra:Activity ;
    rdfs:label "Intercept inbound and outbound payments to/from switched accounts and apply redirect decisions." ;
    dcterms:description "Intercept inbound and outbound payments to/from switched accounts and apply redirect decisions." .

pra:activity_AccountSwitchingService_5 a pra:Activity ;
    rdfs:label "Forward eligible credits to the new account; manage returns or rejects when forwarding is not allowed." ;
    dcterms:description "Forward eligible credits to the new account; manage returns or rejects when forwarding is not allowed." .

pra:activity_AccountSwitchingService_6 a pra:Activity ;
    rdfs:label "Update or re-originate standing orders and scheduled payments per switch instructions. Initiate notifications to origina…" ;
    dcterms:description "Update or re-originate standing orders and scheduled payments per switch instructions. Initiate notifications to originators, billers, and beneficiaries to update stored account details." .

pra:activity_AccountSwitchingService_7 a pra:Activity ;
    rdfs:label "Reconcile redirected/forwarded items and produce audit and customer communications." ;
    dcterms:description "Reconcile redirected/forwarded items and produce audit and customer communications." .

pra:activity_AccountSwitchingService_8 a pra:Activity ;
    rdfs:label "Coordinate with mandate management (e.g., direct debit mandates) for re-registration where applicable." ;
    dcterms:description "Coordinate with mandate management (e.g., direct debit mandates) for re-registration where applicable." .

pra:activity_AccountsPayableProcessing_1 a pra:Activity ;
