pra:func_IncomingInstructionProcessingAndValidation a pra:BusinessFunction ;
    rdfs:label "Incoming Instruction Processing and Validation" ;
    dcterms:description "The Clearing and Settlement Module (CSM) is responsible for processing incoming credit transfer (CT) transactions received from Payment Service Providers (PSPs). Upon receipt, the module performs comprehensive validation to ensure that each instruction meets all required criteria, including correct message formatting, availability of sufficient funds, and adherence to compliance requirements. It also validates bilateral or multilateral rules governing incoming and outgoing transactions between PSPs. Once validated internally, the transactions are forwarded to the external clearing system, which conducts its own compliance and formatting checks. Based on these validations, the clearing system either accepts or rejects the transactions. This function ensures that all payment transactions comply with applicable scheme rules before they are submitted for clearing and settlement." ;
    skos:altLabel "Clearing Incoming Validation",
        "Incoming Clearing Validation",
        "Incoming Instruction Processing",
        "Incoming Instruction Processing (Clearing)" ;
    prov:wasDerivedFrom pra:asset_JourneyXlsx ;
    pra:dependsOn pra:func_PaymentRoutingEngine,
        pra:func_StaticDataManagement,
        pra:sup_MarketInfrastructureGateway ;
    pra:governedBy pra:rule_IncomingInstructionProcessingAndValidation_1,
        pra:rule_IncomingInstructionProcessingAndValidation_2,
        pra:rule_IncomingInstructionProcessingAndValidation_3 ;
    pra:hasActivity pra:activity_IncomingInstructionProcessingAndValidation_1,
        pra:activity_IncomingInstructionProcessingAndValidation_10,
        pra:activity_IncomingInstructionProcessingAndValidation_11,
        pra:activity_IncomingInstructionProcessingAndValidation_2,
        pra:activity_IncomingInstructionProcessingAndValidation_3,
        pra:activity_IncomingInstructionProcessingAndValidation_4,
        pra:activity_IncomingInstructionProcessingAndValidation_5,
        pra:activity_IncomingInstructionProcessingAndValidation_6,
        pra:activity_IncomingInstructionProcessingAndValidation_7,
        pra:activity_IncomingInstructionProcessingAndValidation_8,
        pra:activity_IncomingInstructionProcessingAndValidation_9 ;
    pra:hasApplicabilityNote "All Payment Types" ;
    pra:hasInputText """- Incoming Payment Messages
- Clearing Scheme Rules
- Liquidity and Limit Information""" ;
    pra:hasOutputText """- Accepted Clearing Transactions
- Rejected Instructions""" ;
    pra:hasPhase pra:PhaseIntake ;
    pra:hasPostcondition pra:post_IncomingInstructionProcessingAndValidation_1 ;
    pra:hasPrecondition pra:pre_IncomingInstructionProcessingAndValidation_1,
        pra:pre_IncomingInstructionProcessingAndValidation_2 ;
    pra:hasPurposeStatement pra:purpose_IncomingInstructionProcessingAndValidation_1,
        pra:purpose_IncomingInstructionProcessingAndValidation_2 ;
    pra:isFunctionOf pra:dom_Clearing ;
    pra:modellingStatus "canonical" ;
    pra:normalizedLabel "incoming instruction processing and validation and validation" ;
    pra:providesTo pra:func_ClearingProcessingNetting,
        pra:func_SettlementPreparation,
        pra:sup_CorrespondentNetworkManagement ;
