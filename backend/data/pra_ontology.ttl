    pra:hasPrecondition pra:pre_PaymentServicesReporting_1 ;
    pra:hasPurposeStatement pra:purpose_PaymentServicesReporting_1 ;
    pra:isFunctionOf pra:supdom_DataAnalyticsAndInformationManagement ;
