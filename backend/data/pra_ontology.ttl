pra:sup_PSPInterPSPChargingAndBilling a pra:BusinessFunction,
        pra:SupportingFunction ;
    rdfs:label "PSP Inter-PSP Charging & Billing" ;
    dcterms:description "Calculates and applies charges for interbank transactions, including clearing and settlement fees. Could also be fees for penalties (e.g. delays or SLA breaches)" ;
