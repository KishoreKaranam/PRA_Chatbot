pra:func_BusinessActivityMonitoring a pra:BusinessFunction ;
    rdfs:label "Business Activity Monitoring" ;
    dcterms:description "Continuously monitors end‑to‑end payment processing flows and critical business KPIs to ensure continuity of service. Tracks volumes, latencies, success/fail rates, queue backlogs, and scheme/channel health, with alerting and dashboards for proactive detection and resolution of incidents impacting payment processing" ;
    skos:altLabel "Business Activity Monotoring" ;
