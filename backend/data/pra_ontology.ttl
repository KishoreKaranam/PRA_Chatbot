        pra:activity_BusinessActivityMonitoring_6,
        pra:activity_BusinessActivityMonitoring_7 ;
    pra:hasApplicabilityNote """All Payment Types
RTGS and SCT Inst note: Continuous, real‑time monitoring required due to immediate settlement and systemic risk""" ;
    pra:hasInputText """- Business Events from Payment Processing Steps
- Operational Metrics (volumes, latencies, error rates)
- Status Events from downstream domains""" ;
    pra:hasOutputText """- Operational Dashboards
- Alerts and Threshold Breach Notifications
- Operational Performance Indicators""" ;
