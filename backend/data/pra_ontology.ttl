        pra:activity_AccountSwitchingService_3,
        pra:activity_AccountSwitchingService_4,
        pra:activity_AccountSwitchingService_5,
        pra:activity_AccountSwitchingService_6,
        pra:activity_AccountSwitchingService_7,
        pra:activity_AccountSwitchingService_8 ;
    pra:hasApplicabilityNote "SCT, SCT Inst (conditional), SDD Core, SDD B2B" ;
    pra:hasInputText """- Incoming or Outgoing Payment Transactions
- Account Switching Records
- Redirection Rules""" ;
    pra:hasOutputText """- Redirected Payment Transactions
- Returned or Rejected Transactions (where applicable)
- Switch Notifications""" ;
    pra:hasPhase pra:PhaseExecution ;
    pra:hasPostcondition pra:post_AccountSwitchingService_1,
        pra:post_AccountSwitchingService_2 ;
