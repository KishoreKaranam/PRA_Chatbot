    rdfs:label "Multi-Currency Handling: Manage accounts in different currencies and set up of prefered account for payments involving F…" ;
    dcterms:description "Multi-Currency Handling: Manage accounts in different currencies and set up of prefered account for payments involving FX" .

pra:activity_CustomerAccountsManagement_4 a pra:Activity ;
    rdfs:label "Real-time available balance calculation (incl. reservations)" ;
