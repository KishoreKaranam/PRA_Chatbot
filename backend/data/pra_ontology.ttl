        pra:purpose_AccountSwitchingService_4,
        pra:purpose_AccountSwitchingService_5,
        pra:purpose_AccountSwitchingService_6 ;
    pra:isFunctionOf pra:dom_PaymentProcessing ;
    pra:modellingStatus "canonical" ;
    pra:normalizedLabel "account switching service" ;
    pra:providesTo pra:func_PaymentMessageFormatting,
