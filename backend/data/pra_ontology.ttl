        pra:activity_PSPInterPSPChargingAndBilling_2,
        pra:activity_PSPInterPSPChargingAndBilling_3 ;
    pra:hasApplicabilityNote "SCT, RTGS, Cross Border" ;
    pra:hasInputText """- Clearing volumes
- Bilateral fee agreements""" ;
    pra:hasOutputText "- Inter‑PSP billing statements" ;
    pra:hasPostcondition pra:post_PSPInterPSPChargingAndBilling_1 ;
    pra:hasPrecondition pra:pre_PSPInterPSPChargingAndBilling_1 ;
    pra:hasPurposeStatement pra:purpose_PSPInterPSPChargingAndBilling_1,
        pra:purpose_PSPInterPSPChargingAndBilling_2,
        pra:purpose_PSPInterPSPChargingAndBilling_3 ;
    pra:isFunctionOf pra:supdom_InterPSPInteractions ;
    pra:modellingStatus "canonical" ;
    pra:normalizedLabel "psp inter psp charging and billing" ;
    pra:notes "Modelled as a supporting function from the workbook Function column; grouped under a supporting domain derived from the workbook Layer column." ;
    pra:providesTo pra:sup_FinancialReporting ;
    pra:sourceAsset pra:asset_SupportXlsx ;
    pra:sourceRow 21 ;
    pra:sourceSheet "Supporting domains" ;
    pra:sourceWorkbook "PRA Functional descriptions Supporting domains.xlsx" .

