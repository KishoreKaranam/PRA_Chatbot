pra:PurposeStatement a owl:Class ;
    rdfs:label "Purpose statement" ;
    rdfs:comment "A business-purpose statement attached to a domain or function." ;
    rdfs:subClassOf pra:PRAElement .

pra:BusinessRule a owl:Class ;
    rdfs:label "Business rule" ;
    rdfs:comment "A rule, policy, or control that governs a domain or function." ;
    rdfs:subClassOf pra:PRAElement .

pra:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A key activity performed by a domain or function." ;
    rdfs:subClassOf pra:PRAElement .

