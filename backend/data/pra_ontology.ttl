        pra:activity_MandateManagement_5,
        pra:activity_MandateManagement_6 ;
    pra:hasApplicabilityNote "SDD Core, SDD B2B" ;
    pra:hasInputText """- Debtor Details
- Creditor Details
- Mandate Reference""" ;
    pra:hasOutputText """- Active Mandate Record
- Mandate Status""" ;
    pra:hasPostcondition pra:post_MandateManagement_1 ;
    pra:hasPrecondition pra:pre_MandateManagement_1,
        pra:pre_MandateManagement_2 ;
    pra:hasPurposeStatement pra:purpose_MandateManagement_1,
        pra:purpose_MandateManagement_2,
        pra:purpose_MandateManagement_3 ;
    pra:isFunctionOf pra:supdom_CustomerAndProductManagement ;
    pra:modellingStatus "canonical" ;
    pra:normalizedLabel "mandate management" ;
    pra:notes "Modelled as a supporting function from the workbook Function column; grouped under a supporting domain derived from the workbook Layer column." ;
    pra:providesTo pra:func_AuthorisationHandling,
        pra:func_OrderValidation,
        pra:sup_DirectDebitPreNotificationProcessing ;
