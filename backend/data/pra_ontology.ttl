pra:func_AccountSwitchingService a pra:BusinessFunction ;
    rdfs:label "Account Switching Service" ;
    dcterms:description "Processes payments for customers who have switched accounts to another PSP. Ensures redirection, forwarding, or rejection handling of incoming/outgoing payments during and after a switch window. Coordinates mandate updates, beneficiary/payee records, standing orders, and redirect rules to maintain continuity of service and minimize payment failures." ;
    skos:altLabel "Account Switching service" ;
    prov:wasDerivedFrom pra:asset_JourneyXlsx ;
    pra:dependsOn pra:func_PaymentRoutingEngine,
        pra:func_RTransactionProcessing,
        pra:sup_CustomerAccountsManagement,
        pra:sup_NotificationManagement ;
