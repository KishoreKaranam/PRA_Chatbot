        pra:activity_FraudManagement_4,
        pra:activity_FraudManagement_5 ;
    pra:hasApplicabilityNote "All Payment Types" ;
    pra:hasInputText """- Payment order and transaction data
- Customer behavioural profiles""" ;
    pra:hasOutputText """- Fraud risk score
- Fraud decision (clear, flag)""" ;
