pra:sup_MandateManagement a pra:BusinessFunction,
        pra:SupportingFunction ;
    rdfs:label "Mandate Management" ;
    dcterms:description "Mandate Management handles the lifecycle of mandates required for SEPA Direct Debit (SDD) transactions. It includes setting up mandates with creditor and debtor details, obtaining debtor authorization, amending mandates when information changes, and deleting mandates when no longer valid. For SDD Core, the debtor signs one mandate and sends it to the creditor. For SDD B2B, the debtor signs two mandates—one for the creditor and one for the debtor’s PSP, which performs additional verification during collections." ;
    prov:wasDerivedFrom pra:asset_SupportXlsx ;
    pra:dependsOn pra:func_PaymentInstructionSubmission,
        pra:sup_DocumentManagement,
        pra:sup_MandateManagementProcessing ;
