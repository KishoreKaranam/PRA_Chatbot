    pra:hasPrecondition pra:pre_BusinessActivityMonitoring_1,
        pra:pre_BusinessActivityMonitoring_2 ;
    pra:hasPurposeStatement pra:purpose_BusinessActivityMonitoring_1,
        pra:purpose_BusinessActivityMonitoring_2,
        pra:purpose_BusinessActivityMonitoring_3,
        pra:purpose_BusinessActivityMonitoring_4 ;
    pra:isFunctionOf pra:dom_PaymentProcessing ;
    pra:modellingStatus "canonical" ;
    pra:normalizedLabel "business activity monitoring" ;
    pra:providesTo pra:sup_RiskManagement ;
    pra:sourceAsset pra:asset_JourneyXlsx ;
    pra:sourceRow 35 ;
    pra:sourceSheet "Payment Journey" ;
    pra:sourceWorkbook "PRA Functional descriptions Payments Journey.xlsx" .

