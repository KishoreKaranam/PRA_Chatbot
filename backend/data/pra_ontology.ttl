pra:SupportingFunction a owl:Class ;
    rdfs:label "Supporting function" ;
    rdfs:comment "A business function from the supporting-domains workbook that belongs to a supporting domain or adjacent non-journey grouping." ;
    rdfs:subClassOf pra:BusinessFunction .

pra:PRAElement a owl:Class ;
    rdfs:label "PRA element" ;
    rdfs:comment "Any architecture element in the Payments Reference Architecture." .

pra:BusinessFunction a owl:Class ;
    rdfs:label "Business function" ;
    rdfs:comment "A logical set of behaviours that needs to be performed to obtain a defined result." ;
    rdfs:subClassOf pra:PRAElement .

