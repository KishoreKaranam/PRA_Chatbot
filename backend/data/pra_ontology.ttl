    pra:hasPrecondition pra:pre_FraudManagement_1 ;
    pra:hasPurposeStatement pra:purpose_FraudManagement_1,
        pra:purpose_FraudManagement_2,
        pra:purpose_FraudManagement_3 ;
    pra:isFunctionOf pra:supdom_RiskFraudAndCompliance ;
    pra:modellingStatus "canonical" ;
    pra:normalizedLabel "fraud management" ;
