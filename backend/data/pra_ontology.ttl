        pra:func_SettlementPreparation ;
    pra:inContext pra:context_InterPSPContext ;
    pra:modellingStatus "canonical" ;
    pra:providesTo pra:dom_Settlement,
        pra:sup_CorrespondentNetworkManagement,
        pra:sup_FinancialReporting,
        pra:sup_LiquidityManagement,
        pra:sup_SwiftProcessing ;
    pra:sourceAsset pra:asset_JourneyXlsx,
        pra:asset_ScopeDoc .

pra:func_ClearingProcessingNetting a pra:BusinessFunction ;
    rdfs:label "Clearing Processing (Netting)" ;
    dcterms:description "CSM prioritises  and buckets transactions based on scheme rules, bilaateral agreements and cut-off times and then calculates the net positions of the participating PSP positions which involves determining the actual amount to be debited and credited to each PSP account" ;
    skos:altLabel "Clearing Processing" ;
    prov:wasDerivedFrom pra:asset_JourneyXlsx ;
