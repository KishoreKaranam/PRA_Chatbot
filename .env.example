# ── GraphDB connection ──────────────────────────────────────────────────────
GRAPHDB_BASE_URL=http://localhost:7200
GRAPHDB_REPOSITORY=Payment_Reference_Architecture
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=

# ── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Embedding model (for similarity / vector search) ────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_ENABLED=false          # set true when embeddings are available

# ── Application settings ─────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Agent defaults (overridden from UI) ─────────────────────────────────────
DEFAULT_RETRIEVAL_STRATEGY=hybrid    # sparql | fts | similarity | hybrid
DEFAULT_ANSWER_STYLE=business        # business | technical | concise | detailed
DEFAULT_MAX_RESULTS=10
DEFAULT_SHOW_EVIDENCE=true
DEFAULT_STRICT_ONTOLOGY_MODE=false
DEFAULT_CONFIDENCE_THRESHOLD=0.3
