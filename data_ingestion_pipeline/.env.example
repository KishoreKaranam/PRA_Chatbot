# Copy this file to ".env" and fill in real values.

# Claude via Azure AI Foundry (see https://<resource-name>.services.ai.azure.com/anthropic)
AZURE_FOUNDRY_BASE_URL=https://<resource-name>.services.ai.azure.com/anthropic
AZURE_FOUNDRY_API_KEY=your-foundry-deployment-api-key
# Deployment name you chose in Foundry when deploying the model.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
MAX_AGENT_STEPS=20

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

API_HOST=0.0.0.0
API_PORT=6666
